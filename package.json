{
  "name": "courseware-study",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run import:courses && next build",
    "start": "next start",
    "import:courses": "tsx scripts/import.ts",
    "inspect:course": "tsx scripts/import.ts --inspect",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write app lib scripts tests *.json *.md",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "cheerio": "^1.1.2",
    "lucide-react": "^0.468.0",
    "next": "^15.5.27",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.27",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
